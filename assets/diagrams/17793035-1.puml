@startuml
autonumber
actor "Frontend" as FE
participant "Backend API" as API
database "БД" as DB

FE -> API : POST /api/project-charters/{id}/reject\n{reason}
API -> API : Проверить JWT, право и причину
API -> DB : Получить устав и маршрут
DB --> API : Данные устава и маршрута

alt Устав не найден
  API --> FE : 404
else Устав не на согласовании,\nнет активного шага или другой согласующий
  API --> FE : 400 + {message}
else Отклонение разрешено
  API -> DB : Сохранить отклонение, новую версию\nи событие журнала
  DB --> API : Обновленная карточка
  API --> FE : 200 + карточка
end
@enduml