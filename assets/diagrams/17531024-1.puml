@startuml
autonumber
actor "Клиент API" as FE
participant "Backend API" as API
database "БД" as DB

FE -> API : PUT /api/projects/{id}\n+ JSON
API -> API : Проверить JWT, право project:update\nи входные данные

alt ID в URL и теле не совпадают
  API --> FE : 400 + {message}
else Проверка пройдена
  API -> DB : Найти проект и организацию
  DB --> API : Результат поиска

  alt Проект или организация не найдены
    API --> FE : 404 + {message}
  else Данные найдены
    API -> DB : Проверить уникальность названия
    DB --> API : Результат проверки

    alt Название уже используется
      API --> FE : 400 + {message}
    else Проверки пройдены
      API -> DB : Обновить сведения проекта
      DB --> API : Результат сохранения
      API -> DB : Получить обновленный проект
      DB --> API : Данные проекта
      API --> FE : 200 + ProjectDto
    end
  end
end
@enduml